# Fastlane lanes for payload-mobile.
#
# Only Android lanes exist today, driven by the manually-dispatched
# .github/workflows/android-build.yml. The preview build is split into two
# lanes so the workflow can run them as separate jobs and re-run only the failed
# phase:
#   - `build`   assembles a signed release APK from the `android/` project that
#               `expo prebuild` generates (Continuous Native Generation — the
#               native project is never committed).
#   - `publish` distributes an already-built APK to testers via Firebase App
#               Distribution.
#
# All credentials arrive as environment variables set by the workflow from repo
# secrets; nothing sensitive is stored here.

default_platform(:android)

platform :android do
  desc "Assemble a signed release APK from the prebuilt android/ project"
  lane :build do
    # Expo's generated release buildType is wired to the debug signingConfig, so
    # we override signing at build time with AGP's injected-signing properties
    # (these take precedence over the DSL signingConfig) rather than editing the
    # generated, gitignored build.gradle.
    properties = {
      "android.injected.signing.store.file" => ENV.fetch("ANDROID_KEYSTORE_PATH"),
      "android.injected.signing.store.password" => ENV.fetch("ANDROID_KEYSTORE_PASSWORD"),
      "android.injected.signing.key.alias" => ENV.fetch("ANDROID_KEY_ALIAS"),
      "android.injected.signing.key.password" => ENV.fetch("ANDROID_KEY_PASSWORD"),
    }

    # The workflow supplies a per-build version identifier (e.g. "1.0.0-pr-123"
    # or "1.0.0-<short-sha>") so a tester can tell an installed preview APK apart
    # by which PR/commit it was built from. Applied via AGP's injected
    # versionName property at assemble time — the same override mechanism as the
    # signing properties above — so the prebuilt native project stays
    # version-agnostic and cache-reusable. When unset (a local `fastlane android
    # build` or any non-preview build) the APK keeps the app.json versionName.
    version_name = ENV["ANDROID_VERSION_NAME"]
    unless version_name.nil? || version_name.empty?
      properties["android.injected.version.name"] = version_name
    end

    gradle(
      project_dir: "android",
      task: "assemble",
      build_type: "Release",
      properties: properties,
    )

    # Surface the assembled APK path as a step output so the workflow can stage
    # and upload it as an artifact for the separate `publish` job to consume.
    apk_path = lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]
    if apk_path && ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") { |file| file.puts("apk_path=#{apk_path}") }
    end
  end

  desc "Distribute an already-built APK via Firebase App Distribution"
  lane :publish do
    release = firebase_app_distribution(
      app: ENV.fetch("FIREBASE_ANDROID_APP_ID"),
      service_credentials_file: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_PATH"),
      android_artifact_type: "APK",
      android_artifact_path: ENV.fetch("ANDROID_APK_PATH"),
      # Optional Firebase tester group(s); distributes without a group if unset.
      groups: ENV["FIREBASE_GROUPS"],
      # Comma-separated tester emails added to (and, if new, invited to) every
      # build. The workflow always supplies yo@axross.dev so the tester can
      # install without waiting on a manual Firebase invitation.
      testers: ENV["FIREBASE_TESTERS"],
    )

    # Surface the tester install link as a step output so the workflow can put it
    # in the run summary and (optionally) comment it on the PR.
    testing_uri = release && (release["testingUri"] || release[:testingUri])
    if testing_uri && ENV["GITHUB_OUTPUT"]
      File.open(ENV["GITHUB_OUTPUT"], "a") { |file| file.puts("testing_uri=#{testing_uri}") }
    end
  end
end
