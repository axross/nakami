{
	"cli": {
		"version": ">= 16.0.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"node": "22",
			"environment": "development",
			"developmentClient": true,
			"distribution": "internal"
		},
		"preview": {
			"node": "22",
			"environment": "preview",
			"distribution": "internal"
		},
		"production": {
			"node": "22",
			"environment": "production",
			"autoIncrement": true
		}
	},
	"submit": {
		"production": {
			"android": {
				"track": "internal"
			},
			"ios": {
				"ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
			}
		}
	}
}
